<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Secure Notes third-party notices</title>
  <style>
    body { font: 15px/1.5 system-ui, sans-serif; margin: 2rem auto; max-width: 72rem; padding: 0 1rem; }
    pre { white-space: pre-wrap; }
  </style>
</head>
<body>
  <h1>Secure Notes third-party notices</h1>
  <p>This file lists the licenses of software included in the portable binary.</p>
  {{#each licenses}}
  <section>
    <h2>{{name}}</h2>
    <p>Used by:</p>
    <ul>
      {{#each used_by}}
      <li>{{crate.name}} {{crate.version}}</li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
</body>
</html>
